ENVIRONMENT=production
DOMAIN=threatlens.example.com
# Generate unique values. Keep the database password URL-safe (letters and numbers).
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgresql+psycopg://threatlens:replace-with-a-random-database-password@db:5432/threatlens
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
BOOTSTRAP_ADMIN_EMAIL=admin@your-domain.example
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
MAX_UPLOAD_MB=25
ACCESS_TOKEN_MINUTES=30
MODEL_PATH=ml/artifacts/malware_classifier.pkl
FEATURE_SCHEMA_PATH=ml/artifacts/feature_schema.json
